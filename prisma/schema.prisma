// Pretty Please Print — schema
//
// Two groups of models:
//   * Auth      — owned by Better Auth (User/Session/Account/Verification/Passkey).
//                 Shapes are dictated by the library; verify with
//                 `npx @better-auth/cli generate` after changing plugins.
//   * Domain    — Invite/Story/Comment/Notification, from the handoff data model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Auth
// ===========================================================================

enum Role {
  client
  admin
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// --- username plugin ---
  ///
  /// The login identifier. Folded to lower case on write, which is what makes
  /// the unique index case-insensitive; `displayUsername` keeps whatever was
  /// typed so the profile can show it back.
  ///
  /// Nullable because an account can exist before it has one: the seeded admin
  /// is a row written straight through Prisma, and picks a username and a
  /// password from the set-password link the seed prints.
  username        String? @unique
  displayUsername String?

  /// Avatar fallback, e.g. "AY". Derived from `name` on create. The default is
  /// a safety net only — `databaseHooks.user.create.before` always sets it.
  initials String @default("??")

  /// Exactly one `admin` exists; enforced by the partial unique index
  /// `user_single_admin`, added in the enforce_single_admin migration.
  role Role @default(client)

  /// Who invited this user. Null for the seeded admin only.
  invitedById  String?
  invitedBy    User?   @relation("Invitations", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers User[]  @relation("Invitations")

  // --- admin plugin ---
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  sessions Session[]
  accounts Account[]
  passkeys Passkey[]

  invitesSent   Invite[]       @relation("InviteAuthor")
  auditEvents   AuditEvent[]   @relation("AuditActor")
  stories       Story[]
  comments      Comment[]
  notifications Notification[]

  /// The 'frr' feature-request track — a parallel backlog to the print one.
  featureRequests FeatureRequest[]
  featureComments FeatureComment[]

  @@index([role])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- admin plugin ---
  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id        String @id @default(cuid())
  accountId String

  /// Namespace for `accountId`, so a provider id can never collide with an
  /// internal method. Better Auth writes `local:credential` for a password
  /// account; an OAuth provider would get its own issuer. Required by the
  /// library, and the left half of the uniqueness rule below.
  issuer     String
  providerId String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// scrypt digest as `salt:hash`, written by Better Auth. Only
  /// `providerId: "credential"` rows carry one; a passkey has no password.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

/// Better Auth's generic token store. Backs password-reset links and the
/// WebAuthn challenges. `verification.storeIdentifier: "hashed"` in
/// src/lib/auth.ts means `identifier` holds a digest, not the token — a
/// database reader cannot replay a live reset link.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// WebAuthn credential. `publicKey` is a public key — safe at rest — and the
/// private half never leaves the authenticator.
model Passkey {
  id           String    @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime? @default(now())
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

/// Backs `rateLimit: { storage: "database" }` in src/lib/auth.ts. Shape is
/// dictated by Better Auth: `key` unique, `lastRequest` an epoch-millisecond
/// bigint. Rows are disposable — truncating it only resets the counters.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ===========================================================================
// Domain
// ===========================================================================

/// An invitation to join. There is no public sign-up: a `User` row can only
/// come into existence when a matching pending invite exists (enforced in
/// `src/lib/auth.ts` via `user.validateUserInfo`).
model Invite {
  id    String @id @default(cuid())
  email String

  /// SHA-256 of the invite token. The raw token exists only inside the
  /// emailed link — a database dump does not let anyone accept an invite.
  tokenHash String @unique

  /// Display name the admin suggested; the invitee can override it on claim.
  name String?
  role Role    @default(client)

  invitedById String
  invitedBy   User   @relation("InviteAuthor", fields: [invitedById], references: [id], onDelete: Cascade)

  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  /// Last time the link was (re)sent, for throttling resends in the UI.
  sentAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
  @@map("invite")
}

/// Append-only record of who did what. Closes the A09 gap from SECURITY.md.
///
/// Deliberately denormalised: `actorEmail` and `subject` are copied in at
/// write time so the trail still reads correctly after the user or the story
/// it refers to has been deleted. Nothing in the app ever updates a row here.
model AuditEvent {
  id     String   @id @default(cuid())
  at     DateTime @default(now())
  /// Dotted verb, e.g. "invite.sent", "story.status_changed".
  action String

  actorId    String?
  actor      User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// Kept even if the account is later removed.
  actorEmail String?

  /// What was acted on, in human terms: "PPP-104", "ayla@office.example".
  subject String?

  ip        String?
  userAgent String?
  /// Anything else worth keeping. Never put a token or a raw file in here.
  detail    Json?

  @@index([at])
  @@index([action, at])
  @@index([actorId])
  @@map("auditEvent")
}

enum StoryStatus {
  Requested
  Accepted
  Printing
  Done
  Delivery
  Declined
}

model Story {
  /// Autoincrement so the display ref stays "PPP-" + (100 + id).
  id     Int         @id @default(autoincrement())
  title  String
  status StoryStatus @default(Requested)

  uploaderId String
  uploader   User   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  quantity  Int      @default(1)
  /// Plain string, not an enum — materials are owner-managed data (see
  /// Material model below and src/lib/materials.ts), mirroring how Benefit
  /// already handles the tip catalogue. A retired material is kept exactly
  /// like a retired benefit: past tickets that used it still read correctly,
  /// it just drops off the upload form's choices.
  material  String   @default("PETG")
  colorName String
  colorHex  String
  /// Extra colours for a multi-colour print (AMS/MMU/manual filament swap),
  /// beyond the primary `colorName`/`colorHex` above. Stored as a plain array
  /// of the same catalogue names rather than a join table — the list is
  /// short (capped at 4 total colours, see WishSchema), never queried on its
  /// own, and a join table would only earn its keep past that scale. Empty
  /// for the common single-colour case, which is also why the primary colour
  /// stayed its own two columns instead of folding into this array: every
  /// existing swatch/group-by (dashboard.ts, story cards) keeps working
  /// unchanged against a ticket that predates this feature.
  additionalColorNames String[] @default([])
  tip       String
  note      String   @default("")

  /// Free-text print settings the requester optionally notes (layer height,
  /// infill, supports, temps…), shown to the owner on the ticket so specifics
  /// do not become a back-and-forth. FRR-103, option A — a plain string, not a
  /// structured/gated "advanced mode".
  printSettings String @default("")

  flagged    Boolean @default(false)
  flagReason String?

  // --- uploaded asset. Bytes live in object storage, never the web root. ---
  filename   String
  fileSize   Int
  mimeType   String
  storageKey String

  // --- measured from the mesh at upload time, display only ---
  //
  // There is deliberately no `estimate` column. A print time derived from the
  // bounding box is a guess dressed as a measurement, and the handoff's
  // definition of done rules out claiming to know what the printer will do.
  // A real slicer integration would add one back — see src/lib/models.ts.
  dims String?

  /// Actual filament used, in grams — entered by the owner once known
  /// (weighed, or read off the slicer after the real print), never guessed
  /// at upload time. Same reasoning as the dropped print-time estimate: a
  /// number nobody measured is not shown. Cost is derived from this plus
  /// `printMinutes` and the current MaterialRate — see src/lib/cost.ts.
  weightGrams Int?
  /// Actual wall-clock print time in minutes, entered by the owner the same
  /// way as `weightGrams`. Deliberately not an estimate at any point in the
  /// flow — see docs/architecture.md "Why there is no print-time estimate".
  printMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments      Comment[]
  notifications Notification[]

  @@index([uploaderId])
  @@index([status])
  @@map("story")
}

model Comment {
  id        String   @id @default(cuid())
  storyId   Int
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([storyId])
  @@map("comment")
}

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  recipient   User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  storyId     Int?
  story       Story?   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  /// A notification points at a print story OR a feature request (or neither,
  /// for a withdrawal). The two id columns are mutually exclusive in practice;
  /// the Activity feed routes to /story or /frr on whichever is set.
  featureId   Int?
  feature     FeatureRequest? @relation(fields: [featureId], references: [id], onDelete: Cascade)
  text        String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([recipientId, read])
  @@map("notification")
}

/// The materials a request can be made from — owner-managed, mirroring
/// Benefit exactly. Seeded with the four the app always shipped with
/// (PLA/PETG/TPU/Resin); the owner adds, renames or retires from here at
/// /admin/materials with no code change and no redeploy. `active` retires
/// without deleting, so a past ticket that used a material still reads
/// correctly after it drops off the upload form.
model Material {
  id        String  @id @default(cuid())
  name      String  @unique
  active    Boolean @default(true)
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
  @@map("material")
}

/// Owner-managed $/kg by material, plus one shared $/hour machine rate — the
/// inputs the cost calculator needs (src/lib/cost.ts). Mirrors Benefit: a
/// single-row-per-material table the owner edits, not a hardcoded const, so
/// updating a filament price never touches code. A past ticket's computed
/// cost is not stored — cost is derived at render time from the ticket's
/// `material` + `weightGrams` + `printMinutes` and the CURRENT rate, exactly
/// like the rest of this app's "nothing inferred, nothing stale" rule for
/// numbers on a ticket. If prices need to be historical later, snapshot the
/// rate onto the Story at completion instead of changing this table's shape.
///
/// `material` is a plain string, not a foreign key to Material.name: a rate
/// for a since-retired or since-renamed material should keep working rather
/// than cascade-delete, for the same reason Story.material is a plain string.
model MaterialRate {
  material       String   @id
  dollarsPerKg   Float
  updatedAt      DateTime @updatedAt

  @@map("material_rate")
}

/// The single shared hourly machine rate (electricity, wear, amortised
/// upkeep). One row, id fixed at "default" — simpler than a singleton table
/// pattern with no id at all, and consistent with how Prisma expects a
/// primary key.
model MachineRate {
  id             String   @id @default("default")
  dollarsPerHour Float
  updatedAt      DateTime @updatedAt

  @@map("machine_rate")
}

// ===========================================================================
// Feature requests — the 'frr' track
//
// A parallel backlog: users file feature requests, the printer owner triages
// them with the same flow, conversation, notifications and audit trail as a
// print. Kept in its own tables rather than folded into Story, which stays
// purely about printed models. The status flow mirrors the print one's shape
// (forward-only, one step, Done leaves the board, Declined terminal from
// Requested) with feature-appropriate names — see FEATURE_FLOW in scope.ts.
// ===========================================================================

enum FeatureStatus {
  Requested
  Accepted
  InProgress
  Shipped
  Done
  Declined
}

enum FeaturePriority {
  low
  medium
  high
}

enum FeatureCategory {
  ui
  api
  bug
  other
}

model FeatureRequest {
  /// Autoincrement so the display ref stays "FRR-" + (100 + id).
  id          Int             @id @default(autoincrement())
  title       String
  description String          @default("")
  status      FeatureStatus   @default(Requested)
  priority    FeaturePriority @default(medium)
  category    FeatureCategory @default(other)

  requesterId String
  requester   User   @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments      FeatureComment[]
  notifications Notification[]

  @@index([requesterId])
  @@index([status])
  @@map("featureRequest")
}

model FeatureComment {
  id        String         @id @default(cuid())
  featureId Int
  feature   FeatureRequest @relation(fields: [featureId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime       @default(now())

  @@index([featureId])
  @@map("featureComment")
}

/// A "benefit" — the tip a requester offers the printer owner ("what's in it
/// for you"). Owner-managed data, replacing the old hardcoded TIPS const, so
/// the owner defines the list and marks which ones they currently prefer.
///
/// `Story.tip` stays a plain string with no FK: a past request keeps the exact
/// tip it was made with even after the list is edited or a benefit retired.
/// `active` retires a benefit without deleting that history; `preferred` is
/// what the upload form highlights.
model Benefit {
  id        String   @id @default(cuid())
  label     String   @unique
  preferred Boolean  @default(false)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
  @@map("benefit")
}
